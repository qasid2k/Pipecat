# ---------------------------------------------------------------------------
# SECRETS ONLY. Copy this file to ".env" and paste your real values after "=".
# ".env" is gitignored -- never commit real keys.
#
# Everything that is NOT a secret now lives in config.yaml: which telephony
# vendor, ports, ARI URL, the STT/LLM/TTS providers, the model, the voice, the
# persona and the turn-taking timing. config.yaml refers to the variables below
# BY NAME, so the two files never contain the same thing twice.
#
# If you set a variable here that config.yaml does not name, it does nothing.
# ---------------------------------------------------------------------------

# Deepgram -- used for BOTH speech-to-text and text-to-speech.
# Get it from https://console.deepgram.com  ($200 free credit, no card)
DEEPGRAM_API_KEY=

# Gemini -- the LLM ("the brain"). Free tier, no card.
# Get it from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# ARI (Asterisk REST Interface) -- call control: transfer and routing.
# These match the [voiceagent] user in /etc/asterisk/ari.conf on the VM.
#
# config.yaml names these under transport.asterisk.ari_user_env / ari_pass_env.
# If it names them, they MUST be set -- the bot refuses to start otherwise,
# rather than silently running with transfer broken. To run deliberately
# without call control, comment out `ari_pass_env` in config.yaml instead.
# ---------------------------------------------------------------------------
ARI_USER=voiceagent
ARI_PASSWORD=
