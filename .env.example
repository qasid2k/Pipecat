# ---------------------------------------------------------------------------
# API keys. Copy this file to ".env" and paste your real keys after the "=".
# ".env" itself is gitignored -- never commit real keys.
# ---------------------------------------------------------------------------

# Deepgram -- used for BOTH speech-to-text and text-to-speech.
# Get it from https://console.deepgram.com  ($200 free credit, no card)
DEEPGRAM_API_KEY=

# Gemini -- the LLM ("the brain"). Free tier, no card.
# Get it from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# Where the AudioSocket server listens. Must match the dialplan on Asterisk:
#   AudioSocket(<uuid>,<this-host>:<this-port>)
# If bot.py runs ON the Asterisk box itself, use 127.0.0.1 in the dialplan.
# ---------------------------------------------------------------------------
AUDIOSOCKET_HOST=0.0.0.0
AUDIOSOCKET_PORT=8090
