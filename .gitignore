# Secrets -- never commit real API keys
.env

# Virtual environment (rebuildable from requirements)
.venv/

# Python bytecode / caches
__pycache__/
*.pyc

# Call transcripts / recordings -- real conversation data, not source code
recordings/

# Test run logs
*.log

# Obsidian per-machine UI state (which panes are open, window geometry).
# The rest of .obsidian/ IS committed, so vault settings are shared.
docs-vault/.obsidian/workspace.json
docs-vault/.obsidian/workspace-mobile.json
